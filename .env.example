# Configure these as environment variables in your hosting provider.
TZ=Asia/Kolkata
REMINDER_LEAD_DAYS=3
DATABASE_PATH=tracker.db
# Email alerts (SMTP credentials must be kept secret; never put them in HTML or GitHub)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alert-account@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-alert-account@example.com
ALERT_EMAIL=recipient@example.com
# Optional comma-separated official pages/RSS URLs to monitor for content changes.
# A page change sends an email for manual review; it never silently changes statutory dates.
OFFICIAL_SOURCE_URLS=
CORS_ORIGINS=*
